APP_NAME="Snap Foodd"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snap_foodd_local
DB_USERNAME=snap_foodd_local
DB_PASSWORD=

# Google OAuth Web Client ID used to validate Flutter-issued Google ID tokens.
# Never commit the real value.
GOOGLE_CLIENT_ID=

# Comma-separated browser origins allowed to call the API.
# Example production value:
# CORS_ALLOWED_ORIGINS=https://admin.snapfoodd.com
CORS_ALLOWED_ORIGINS=

# Local-only admin bootstrap account. Leave empty outside local development.
ADMIN_BOOTSTRAP_EMAIL=
