{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "snap-foodd/backend",
  "type": "project",
  "description": "Snap Foodd Laravel backend API and admin application.",
  "keywords": [
    "laravel",
    "snap-foodd",
    "api"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "laravel/sanctum": "^4.3",
    "google/apiclient": "^2.20"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php artisan test",
    "format": "@php vendor/bin/pint"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
